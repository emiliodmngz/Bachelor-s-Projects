   "source": [
    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "class TimeSeriesLinearRegressor:\n",
    "    def __init__(self, lags=10, freq='h'):\n",
    "        self.lags = lags\n",
    "        self.freq = freq\n",
    "        self.model = LinearRegression()\n",
    "        self.fitted = False\n",
    "        self.feature_names = [f\"lag_{i}\" for i in range(1, lags + 1)]\n",
    "\n",
    "    def preparar_serie(self, serie):\n",
    "        if not np.issubdtype(serie.index.dtype, np.datetime64):\n",
    "             serie.index = pd.to_datetime(serie.index)\n",
    "        serie = serie.sort_index()\n",
    "        return serie.resample(self.freq).mean().ffill()\n",
    "\n",
    "    def crear_lags(self, serie):\n",
    "        lags_data = {'y': serie}\n",
    "        for i in range(1, self.lags + 1):\n",
    "            lags_data[f\"lag_{i}\"] = serie.shift(i)\n",
    "        return pd.DataFrame(lags_data)\n",
    "        \n",
    "    def train_test_split(self, X, y, test_size=0.3):\n",
    "        n = int(len(X) * (1 - test_size))\n",
    "        return X.iloc[:n], X.iloc[n:], y.iloc[:n], y.iloc[n:]\n",
    "\n",
    "    def fit(self, serie, test_size=0.3):\n",
    "        self.serie_interna = self.preparar_serie(serie)\n",
    "        data = self.crear_lags(self.serie_interna)\n",
    "        \n",
    "        y = data.dropna().y\n",
    "        X = data.dropna().drop(['y'], axis=1)\n",
    "\n",
    "        self.X_train, self.X_test, self.y_train, self.y_test = self.train_test_split(X, y, test_size)\n",
    "        self.model.fit(self.X_train, self.y_train)\n",
    "        self.fitted = True\n",
    "\n",
    "    def predict_test(self):\n",
    "        if not self.fitted: raise Exception(\"Modelo no entrenado\")\n",
    "        return pd.Series(self.model.predict(self.X_test), index=self.y_test.index)\n",
    "\n",
    "    def score(self):\n",
    "        if not self.fitted: raise Exception(\"Modelo no entrenado\")\n",
    "        y_pred = self.predict_test()\n",
    "        mape = mean_absolute_percentage_error(self.y_test, y_pred)\n",
    "        mae = mean_absolute_error(self.y_test, y_pred)\n",
    "        return {\"MAPE\": mape, \"MAE\": mae}\n",
    "\n",
    "    def forecast(self, steps):\n",
    "        if not self.fitted: raise Exception(\"Primero entrena el modelo con .fit()\")\n",
    "        valores_recientes = list(self.serie_interna.iloc[-self.lags:].values)\n",
    "        predicciones = []\n",
    "        last_date = self.serie_interna.index[-1]\n",
    "        future_dates = pd.date_range(start=last_date, periods=steps+1, freq=self.freq)[1:]\n",
    "\n",
    "        for _ in range(steps):\n",
    "            entrada = []\n",
    "            for i in range(1, self.lags + 1):\n",
    "                entrada.append(valores_recientes[-i])\n",
    "            \n",
    "            entrada_df = pd.DataFrame([entrada], columns=self.feature_names)\n",
    "            pred = self.model.predict(entrada_df)[0]\n",
    "            predicciones.append(pred)\n",
    "            valores_recientes.append(pred) \n",
    "        return pd.Series(predicciones, index=future_dates)\n",
    "    \n",
    "    # --- AQUÍ ESTÁ LA MAGIA VISUAL ---\n",
    "    def plot_all(self, steps=0, figsize=(20,10), std_scale=2):\n",
    "        if not self.fitted: raise Exception(\"Modelo no entrenado\")\n",
    "\n",
    "        plt.figure(figsize=figsize)\n",
