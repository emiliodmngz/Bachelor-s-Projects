    "from statsmodels.tsa.api import ExponentialSmoothing\n",
    "\n",
    "def plot_exp_smoothing(serie,periodo=None, test_size=0.2, predict=24,trend='add', seasonal='add'):\n",
    "\n",
    "    d = serie.copy()\n",
    "    d.index = pd.to_datetime(serie.index)\n",
    "\n",
    "    # 2) Determinar frecuencia\n",
    "    freq = d.index.inferred_freq\n",
    "    if freq is None:\n",
    "        serie = d.resample('h').mean().ffill()\n",
    "        freq = 'h'\n",
    "    d = d.asfreq(freq)\n",
    "    \n",
    "    n = len(serie)\n",
    "    split = int(n * (1 - test_size))\n",
    "\n",
    "    train = serie.iloc[:split]\n",
    "    test  = serie.iloc[split:]\n",
    "\n",
    "    ses = ExponentialSmoothing(train, trend='add',seasonal='add', seasonal_periods=periodo).fit()\n",
    "\n",
    "    #pronostico\n",
