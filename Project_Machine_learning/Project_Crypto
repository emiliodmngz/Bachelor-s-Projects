    "def plot_moving_average(serie,window,figsize=(10,6), intervalos = False,escala = 2, anomalies = False):\n",
    "    rolling_mean = serie.rolling(window=window).mean()\n",
    "    plt.figure(figsize=figsize)\n",
    "    plt.title(\"Media movil \\n tamaño de ventana:{}\".format(window))\n",
    "    plt.plot(rolling_mean,'g',label='Tendencia por media movil')\n",
    "    if intervalos:\n",
    "        mae = mean_absolute_error(serie[window:],rolling_mean[window:])\n",
    "        std = np.std(serie[window:] - rolling_mean[window:])\n",
    "        low_ = rolling_mean - (mae+escala*std)\n",
    "        upp_ = rolling_mean + (mae+escala*std)\n",
    "        plt.plot(upp_,'r--', label=\"Límites sup/inf\")\n",
    "        plt.plot(low_,'r--')\n",
    "        if anomalies:\n",
    "            anoms = pd.DataFrame(index = serie.index,columns=serie.columns)\n",
    "            anoms[serie<low_] = serie[serie<low_]\n",
    "            anoms[serie>upp_] = serie[serie>upp_]\n",
    "            plt.plot(anoms,'ro',markersize=10)   \n",
    "    mape = mean_absolute_percentage_error(serie[window:], rolling_mean[window:])\n",
    "    print('Error abs. medio porcentual: {:.3f}% '.format(mape))\n",
    "    plt.plot(serie[window:],label='Valores reales')\n",
    "    plt.legend(loc='upper left')\n",
    "    plt.grid()\n",
    "    plt.show()"
   ]
